{
  "name": "@spotradar/frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node --disable-warning=ExperimentalWarning scripts/build.mjs",
    "dev": "node --disable-warning=ExperimentalWarning scripts/build.mjs --watch",
    "test": "node --disable-warning=ExperimentalWarning --test \"src/**/*.test.ts\" \"scripts/**/*.test.mjs\"",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.1",
    "@playwright/test": "^1.65.1"
  }
}
